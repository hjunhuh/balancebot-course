<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 앱 테마: material 라이브러리의 기본 테마를 그대로 씁니다. 다크 모드는 DayNight 가 자동 처리합니다. -->
    <style name="Theme.BalanceBot" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#3F51B5</item>
        <item name="colorPrimaryVariant">#303F9F</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#009688</item>
        <item name="colorSecondaryVariant">#00796B</item>
        <item name="colorOnSecondary">#FFFFFF</item>
    </style>

    <!-- 레이아웃에서 반복되는 속성을 묶은 스타일입니다. -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TeleValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ParamLabel">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ParamInput">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
